printUSBDevices() {
  typeset -a usbDevices
  typeset -a devices
  
  # Get all disk devices with their transport type, size, and model
  while IFS= read -r line; do
    device=$(echo "$line" | awk '{print $1}')
    transport=$(echo "$line" | awk '{print $3}')
    size=$(echo "$line" | awk '{print $4}')
    
    # Only consider devices with USB transport
    if [ "$transport" = "usb" ]; then
      device_path="/dev/$device"
      device_sys="/sys/block/$device"
      
      # Verify device exists
      if [ ! -e "$device_sys" ]; then
        continue
      fi
      
      # Skip devices with 0 size (empty card readers, etc.)
      if [ "$size" = "0B" ] || [ -z "$size" ]; then
        continue
      fi
      
      # Get device size in bytes for additional check
      device_size_bytes=$(blockdev --getsize64 "$device_path" 2>/dev/null || echo "0")
      if [ "$device_size_bytes" = "0" ] || [ -z "$device_size_bytes" ]; then
        # Try alternative method
        device_size_bytes=$(lsblk -b -d -n -o SIZE "$device_path" 2>/dev/null | head -1 || echo "0")
      fi
      
      # Skip if device has no usable size
      if [ "$device_size_bytes" = "0" ] || [ -z "$device_size_bytes" ]; then
        continue
      fi
      
      # Double-check with udev that it's really USB
      udev_info=$(udevadm info --query=property --path="$device_sys" 2>/dev/null)
      bus_type=$(echo "$udev_info" | grep -Po 'ID_BUS=\K\w+' || echo "")
      
      # Only add if both transport and bus type indicate USB, and device has usable size
      if [ "$transport" = "usb" ] && [ "$bus_type" = "usb" ] && [ "$device_size_bytes" != "0" ]; then
        usbDevices+=("$device_path")
      fi
    fi
  done < <(lsblk -d -o NAME,TYPE,TRAN,SIZE 2>/dev/null | grep -E '\sdisk\s')
  
  if [ ${#usbDevices[@]} -eq 0 ]; then
    USB=""
  elif [ ${#usbDevices[@]} -eq 1 ]; then
    USB="${usbDevices[0]}"
  else
    USB="${usbDevices[*]}"
  fi
}

writetousb() {
printUSBDevices
if [ -z "$USB" ]
then
      echo -e "[ \e[91m%\e[0m ] : No USB device found. Make sure there is ONE device inserted and try again. Abort"
      _back_to_menu
      [[ "${CLI_MODE}" == "yes" ]] && exit 1
      return
fi

# Check if multiple USB devices found
if [ -n "$USB" ] && [ "$(echo "$USB" | wc -w)" -gt 1 ]; then
    echo -e "[ \e[91m%\e[0m ] : Multiple USB devices found. Please disconnect all but ONE USB device and try again."
    echo -e "[ \e[93m%\e[0m ] : Found devices: $USB"
    _back_to_menu
    [[ "${CLI_MODE}" == "yes" ]] && exit 1
    return
fi

# Find ISO file
iso_file=$(find . -maxdepth 1 -name "*.iso" -type f 2>/dev/null | grep -i pearOS | head -1)

if [ -z "$iso_file" ]; then
    echo -e "[ \e[91m%\e[0m ] : No pearOS ISO file found. Abort"
    _back_to_menu
    [[ "${CLI_MODE}" == "yes" ]] && exit 1
    return
fi

# Get ISO file size
iso_size=$(stat -f%z "$iso_file" 2>/dev/null || stat -c%s "$iso_file" 2>/dev/null)
if command -v numfmt >/dev/null 2>&1; then
    iso_size_display=$(numfmt --to=iec-i --suffix=B "$iso_size" 2>/dev/null | sed 's/iB/B/')
else
    # Fallback calculation without numfmt
    iso_size_mb=$((iso_size / 1024 / 1024))
    if [ $iso_size_mb -ge 1024 ]; then
        iso_size_gb=$((iso_size_mb / 1024))
        iso_size_display="${iso_size_gb} GB"
    else
        iso_size_display="${iso_size_mb} MB"
    fi
fi

# Get USB device size
usb_size=$(blockdev --getsize64 "$USB" 2>/dev/null || echo "0")
if [ "$usb_size" = "0" ]; then
    usb_size=$(lsblk -b -d -n -o SIZE "$USB" 2>/dev/null | head -1 || echo "0")
fi
if command -v numfmt >/dev/null 2>&1 && [ "$usb_size" != "0" ]; then
    usb_size_display=$(numfmt --to=iec-i --suffix=B "$usb_size" 2>/dev/null | sed 's/iB/B/')
else
    # Fallback calculation without numfmt
    if [ "$usb_size" != "0" ]; then
        usb_size_mb=$((usb_size / 1024 / 1024))
        if [ $usb_size_mb -ge 1024 ]; then
            usb_size_gb=$((usb_size_mb / 1024))
            usb_size_display="${usb_size_gb} GB"
        else
            usb_size_display="${usb_size_mb} MB"
        fi
    else
        usb_size_display="Unknown"
    fi
fi

# Display confirmation
echo ""
echo -e "[ \e[94m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m ]"
echo -e "[ \e[93m%\e[0m ] Flash ISO to USB - Confirmation"
echo -e "[ \e[94m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m ]"
echo -e "[ \e[92m%\e[0m ] ISO File: \e[96m$(basename "$iso_file")\e[0m"
echo -e "[ \e[92m%\e[0m ] ISO Size: \e[96m${iso_size_display}\e[0m"
echo -e "[ \e[92m%\e[0m ] USB Device: \e[96m${USB}\e[0m"
echo -e "[ \e[92m%\e[0m ] USB Size: \e[96m${usb_size_display}\e[0m"
echo ""
echo -e "[ \e[91m⚠\e[0m ] \e[91mWARNING: This will erase ALL data on ${USB}\e[0m"
echo ""
if [[ "${CLI_MODE}" == "yes" && "${CLI_YES}" == "yes" ]]; then
    confirm="yes"
    echo -e "[\e[93m%\e[0m] Continue? (yes/no): yes  (--yes)"
else
    read -p "$(echo -e '[\e[93m%\e[0m] Continue? (yes/no): ')" confirm < /dev/tty
fi

if [ "$confirm" != "yes" ]; then
    echo -e "[ \e[91m%\e[0m ] : Operation cancelled by user"
    _back_to_menu
    [[ "${CLI_MODE}" == "yes" ]] && exit 1
    return
fi

echo ""
echo -e "[ \e[92m%\e[0m ] : Flashing ISO to USB device..."
echo -e "[ \e[93m%\e[0m ] : This may take several minutes, please wait..."
sudo dd if="$iso_file" of="$USB" bs=4M status=progress conv=fsync 2>&1
sync
echo ""
echo -e "[ \e[92m%\e[0m ] : Your bootable USB is ready!"
_back_to_menu
}


# rclone reads its config from $HOME/.config/rclone/rclone.conf. build-binary runs
# as root via sudo, so run the uploader as the invoking (non-root) user instead,
# otherwise it looks in /root and finds no remotes.
_run_upload() {
    if [[ -n "${SUDO_USER:-}" ]] && [[ "$(id -u)" -eq 0 ]]; then
        sudo -u "${SUDO_USER}" -H "${UPLOAD_SCRIPT}" "$@"
    else
        "${UPLOAD_SCRIPT}" "$@"
    fi
}

# Standalone CLI chroot: enters interactive_chroot() on whatever airootfs
# currently exists in ./work, independent of --build. This is the only way
# to chroot "after a build" -- once a build reaches the squashfs step,
# mkarchiso deletes the airootfs directory to save space, so there's
# nothing left to chroot into. If --build is also given, CLI_CHROOT is
# instead handled inline by non_interactive_build (via INTERACTIVE_CHROOT),
# which offers the chroot at the one point mid-build where airootfs still
# exists but pacstrap/customize_airootfs have already run.
cli_chroot() {
    local airootfs_dir
    airootfs_dir=$(find ./work -maxdepth 3 -type d -path "*/x86_64/airootfs" 2>/dev/null | head -n1)
    if [[ -z "${airootfs_dir}" ]]; then
        echo -e "[ \e[91m%\e[0m ] : No airootfs found under ./work to chroot into." >&2
        echo -e "[ \e[93m%\e[0m ] : It only exists between pacstrap and the squashfs step -- run" >&2
        echo -e "[ \e[93m%\e[0m ] : \"--build --chroot\" to build up to that point and chroot into it," >&2
        echo -e "[ \e[93m%\e[0m ] : or if a build already finished, its airootfs has already been" >&2
        echo -e "[ \e[93m%\e[0m ] : consumed into the ISO and can't be chrooted into anymore." >&2
        exit 1
    fi
    interactive_chroot "${airootfs_dir}"
    # Always stops here, even if --build was also given -- --chroot never
    # falls through to building the squashfs/ISO in the same run (see
    # check_chroot_request for the equivalent mid-pipeline case). airootfs
    # keeps every change; run "--build" again afterward (same ./work,
    # pacstrap skipped) whenever you're ready to finish the ISO.
    echo -e "[ \e[93m%\e[0m ] : Not building the ISO in this run. Run \"--build\" again (pacstrap is skipped) whenever you're ready to finish it."
    exit 0
}

# CLI equivalent of the ISO Uploader submenu (uploadmenu()'s case 1-4).
# Bypasses that submenu's own `read` prompts entirely -- the sub-action and
# filename come from CLI_UPLOAD_ACTION/CLI_DELETE_FILE (set by the option
# parser), not from interactive input.
cli_upload_action() {
    if [[ ! -x "${UPLOAD_SCRIPT}" ]]; then
        echo -e "[ \e[91m%\e[0m ] : ISO Uploader script not found or not executable: ${UPLOAD_SCRIPT}" >&2
        exit 1
    fi

    case "${CLI_UPLOAD_ACTION}" in
        upload)
            _run_upload
            ;;
        list)
            _run_upload --list
            ;;
        links)
            _run_upload --get-links
            ;;
        delete)
            if [[ -z "${CLI_DELETE_FILE}" ]]; then
                echo -e "[ \e[91m%\e[0m ] : --delete-cdn requires a filename" >&2
                exit 1
            fi
            if [[ "${CLI_YES}" == "yes" ]]; then
                printf 'y\n' | _run_upload --delete "${CLI_DELETE_FILE}"
            else
                _run_upload --delete "${CLI_DELETE_FILE}"
            fi
            ;;
    esac
}

uploadmenu() {
    if [[ ! -x "${UPLOAD_SCRIPT}" ]]; then
        echo -e "[ \e[91m%\e[0m ] : ISO Uploader script not found or not executable: ${UPLOAD_SCRIPT}"
        mainmenu
        return
    fi

    echo -ne "
$(magentaprint 'ISO Uploader:')
$(magentaprint '1)') Upload ISO file(s) to CDN
$(magentaprint '2)') List ISO files on CDN
$(magentaprint '3)') Get public links for ISO files on CDN
$(magentaprint '4)') Delete an ISO file from CDN
$(redprint '0)') Back to main menu

[ \e[93m% \e[0m] : "
    read -r upload_ans < /dev/tty
    case $upload_ans in
    1)
        # Only the upload action reads local ISO files, so only it needs out_dir.
        # out_dir is populated by _set_overrides, which runs during an actual build;
        # fall back to the default './out' when the menu is used without building first.
        local _upload_out_dir="${out_dir}"
        if [[ -z "${_upload_out_dir}" ]]; then
            _upload_out_dir="$(realpath -- './out')"
        fi
        if [[ ! -d "${_upload_out_dir}" ]]; then
            echo -e "[ \e[91m%\e[0m ] : Output directory not found: ${_upload_out_dir}"
        else
            ( cd -- "${_upload_out_dir}" && _run_upload )
        fi
        ;;
    2)
        _run_upload --list
        ;;
    3)
        _run_upload --get-links
        ;;
    4)
        read -p "$(echo -e '[\e[93m%\e[0m] Filename to delete: ')" del_file < /dev/tty
        _run_upload --delete "${del_file}"
        ;;
    0)
        mainmenu
        return
        ;;
    *)
        fn_fail
        ;;
    esac
    mainmenu
}

shaiso() {
    # Find ISO file the same way writetousb does
    local iso_file
    iso_file=$(find . -maxdepth 1 -name "*.iso" -type f 2>/dev/null | grep -i pearOS | head -1)

    if [ -z "$iso_file" ]; then
        echo -e "[ \e[91m%\e[0m ] : No pearOS ISO file found. Abort"
        _back_to_menu
        [[ "${CLI_MODE}" == "yes" ]] && exit 1
        return
    fi

    echo -e "[ \e[92m%\e[0m ] : Computing sha256sum for $(basename "$iso_file")..."
    sha256sum -- "$iso_file" > ./sha.txt
    echo -e "[ \e[92m%\e[0m ] : Written to ./sha.txt"
    cat ./sha.txt
    _back_to_menu
}

_print_cli_usage() {
    cat <<'EOF'
Usage: sudo ./build-binary [options]

Running with no options opens the interactive menu, same as before. Passing
any option below skips the menu and runs directly instead -- every action
is 100% flag-driven, nothing is ever decided by a menu prompt. Flags can be
given in any order (only a flag's own VALUE has to immediately follow it,
e.g. "--compression fastest"); build-binary just collects them all before
deciding what to do.

Actions chain in this fixed order when combined: chroot -> build -> usb ->
upload. Each step only runs if its flag was given, e.g.
  --build --compression fastest --sha256 --upload
builds, checksums, then uploads, all in one run (a failing step aborts the
rest, via `set -e`).

Build (menu 1):
  --build                  build the ISO
  --profile NAME            archiso profile directory to build (default: pear)
  --compression VALUE       1|default   xz, balanced (default)
                             2|max       xz level 9, smaller/slower
                             3|big       zstd level 3, bigger/faster
                             4|fastest   lz4, minimal compression
                             5|slim      zstd level 19 (Pear Slim)
  --filename NAME            override the ISO's base filename (profiledef.sh's
                              iso_name). The final name is always
                              NAME-<version>-<arch>.iso -- mkarchiso appends
                              that suffix itself. NOTE: --usb/--sha256/--upload
                              locate the ISO with `grep -i pearos`, so keep
                              that substring in NAME if you plan to chain them.
  --clean                   delete ./work first instead of resuming it
  --sha256                  write sha256sum of the resulting ISO to ./sha.txt
                             (with --build: runs after the build; alone: just
                             checksums the existing ISO, same as menu 5)

Interactive chroot -- no menu, no y/n prompt, purely flag-driven. --chroot
ALWAYS stops right after the chroot shell exits -- it never falls through
to building the squashfs/ISO in the same run, even combined with --build:
  --chroot                 if an airootfs already exists under ./work (from
                            an earlier run, even days ago -- it's never
                            deleted): chroots into it immediately, then
                            stops. Run "--build" again afterward (same
                            ./work, pacstrap skipped) to finish the ISO.
                            Errors out if no airootfs exists yet.
  --chroot --build          if no airootfs exists yet: builds up to the
                            point where it does (pacstrap done, squashfs
                            not made), chroots in, then stops -- same as
                            above, run "--build" again afterward to finish.
                            If an airootfs already exists, behaves exactly
                            like plain --chroot (pacstrap is skipped).

Clean project directory (menu 2):
  --clean-project          delete ./work (does not touch the ISO file)

Write ISO to USB (menu 3):
  --usb                    auto-detect the (single) USB device and write
  -y, --yes                skip the "Continue? (yes/no)" confirmation

Upload to CDN / ISO Uploader (menu 4):
  --upload                 upload ISO file(s) from the repo root to the CDN
  --list-cdn                list ISO files on the CDN
  --get-links               print public links for ISO files on the CDN
  --delete-cdn FILENAME      delete FILENAME from the CDN
  -y, --yes                 with --delete-cdn, skip the confirmation prompt

  -h, --help               show this help and exit

Examples:
  sudo ./build-binary --profile pear --compression fastest --clean --sha256 --chroot
  sudo ./build-binary --build --filename pearOS-custom --compression slim
  sudo ./build-binary --chroot                      # edit, exit, done -- rebuild later
  sudo ./build-binary --chroot --build              # edit, exit, rebuild squashfs+ISO now
  sudo ./build-binary --clean-project
  sudo ./build-binary --usb --yes
  sudo ./build-binary --delete-cdn old-build.iso --yes
EOF
}

# Non-interactive build driven by CLI flags. Mirrors actual_build()'s logic
# (existing-work-dir reuse, compression selection, chroot gate, permission
# fixup) but takes every decision from flags instead of `read` prompts, so
# it can be scripted or driven by a GUI without an expect-style automation
# layer -- see CLI_* globals set by the option parser at the bottom of this
# file.
non_interactive_build() {
    local start end
    start=$(date +%s)

    if [[ "${CLI_CLEAN}" == "yes" ]]; then
        echo -e "[ \e[92m%\e[0m ] : --clean requested, removing ./work"
        rm -rf ./work
    fi

    local existing_out=""
    if [[ -d "./work" ]]; then
        existing_out=$(find ./work -maxdepth 1 -type d -name "tmp.*" | head -n1)
    fi

    if [[ -n "${existing_out}" ]]; then
        export OUT="${existing_out}"
        echo -e "[ \e[92m%\e[0m ] : Using existing work directory: ${OUT}"

        # _run_once markers only record "did this function ever run", not
        # "is its output still current". airootfs is never deleted (see
        # cli_chroot above), so the whole point of reusing OUT is to let
        # you chroot in, tweak something, and rebuild -- but the squashfs
        # and the ISO itself are each gated by their own single marker from
        # the previous run, and would otherwise be skipped even though
        # airootfs changed underneath them. Clear just those markers so the
        # image is always regenerated from whatever is in airootfs right
        # now; pacstrap/customize_airootfs markers are left alone since
        # that's the slow part this is meant to let you skip.
        echo -e "[ \e[92m%\e[0m ] : Clearing cached squashfs/ISO markers so the image reflects any chroot changes..."
        rm -f -- "${OUT}"/base._mkairootfs_* "${OUT}"/base._prepare_airootfs_image \
                 "${OUT}"/*._build_iso_image "${OUT}"/build._build_buildmode_*
    else
        [[ -d "./work" ]] || mkdir work
        export OUT=$(mktemp -d --tmpdir=work)
        mkdir -p "${OUT}"
        # DISABLED -- see the identical block in the interactive path above.
        # pear/pacman.conf and pear/airootfs/etc/pacman.conf are maintained by
        # hand in the profile; regenerating them from packages/pacman.out plus
        # the build host's /etc/pacman.conf reverted [cachyos] and the explicit
        # Arch mirrors on every build.
        #_detect_host_repos
        #_generate_pear_pacman_conf
        #_copy_host_mirrorlists
        #echo -e "[ \e[92m%\e[0m ] : Copying [ \e[92mpear/pacman.conf\e[0m ] to [ \e[92mpear/airootfs/etc/.\e[0m ] . . ."
        #cp -r pear/pacman.conf pear/airootfs/etc/.
        echo -e "[ \e[92m%\e[0m ] : Copying [ \e[92mpackages/packages.x86_64\e[0m ] to [ \e[92mpear/airootfs/etc/packages.x86_64\e[0m ] . . ."
        cp packages/packages.x86_64 pear/airootfs/etc/packages.x86_64
        echo -e "[ \e[92m%\e[0m ] : Copying [ \e[92mpackages/packages.x86_64\e[0m ] to [ \e[92mpear/packages.x86_64\e[0m ] . . ."
        cp packages/packages.x86_64 pear/packages.x86_64
    fi

    local compression_opts
    case "${CLI_COMPRESSION}" in
        1|default|xz)
            compression_opts="('-comp' 'xz' '-Xbcj' 'x86' '-b' '1M' '-Xdict-size' '1M')" ;;
        2|max|small)
            compression_opts="('-comp' 'xz' '-Xbcj' 'x86' '-b' '1M' '-Xdict-size' '100%')" ;;
        3|big|zstd)
            compression_opts="('-comp' 'zstd' '-Xcompression-level' '3' '-b' '1M')" ;;
        4|fastest|lz4)
            compression_opts="('-comp' 'lz4' '-b' '1M')" ;;
        5|slim|pearslim)
            compression_opts="('-comp' 'zstd' '-Xcompression-level' '19' '-b' '1M')" ;;
        *)
            echo -e "[ \e[91m%\e[0m ] : Unknown --compression value '${CLI_COMPRESSION}'" >&2
            exit 1
            ;;
    esac

    if [[ -f "pear/profiledef.sh" ]]; then
        cp pear/profiledef.sh pear/profiledef.sh.backup
        trap 'mv pear/profiledef.sh.backup pear/profiledef.sh 2>/dev/null; trap - EXIT INT TERM' EXIT INT TERM
        sed -i "s|^airootfs_image_tool_options=.*|airootfs_image_tool_options=${compression_opts}|" pear/profiledef.sh
        echo -e "[\e[92m%\e[0m] Compression options updated in profiledef.sh"
        if [[ -n "${CLI_FILENAME}" ]]; then
            # profiledef.sh's iso_name is only the base -- mkarchiso always
            # appends "-<version>-<arch>.iso" itself. writetousb/shaiso/the
            # ISO Uploader all locate the ISO with `grep -i pearOS`, so a
            # --filename that drops that substring will still build fine
            # but won't be auto-found by --usb/--sha256/--upload afterward.
            _cli_filename_base="${CLI_FILENAME%.iso}"
            sed -i "s|^iso_name=.*|iso_name=\"${_cli_filename_base}\"|" pear/profiledef.sh
            echo -e "[\e[92m%\e[0m] ISO filename base overridden to \"${_cli_filename_base}\" (final: ${_cli_filename_base}-<version>-<arch>.iso)"
        fi
    fi

    echo -e "[ \e[92m%\e[0m ] : Building the ISO (non-interactive) . . ."
    # If --chroot was already handled standalone (cli_chroot, called by the
    # dispatcher right before this when an airootfs already existed), don't
    # offer it again mid-pipeline -- that only applies to a fresh build
    # that hasn't run pacstrap yet.
    if [[ "${CLI_CHROOT_HANDLED_STANDALONE:-no}" == "yes" ]]; then
        export INTERACTIVE_CHROOT="no"
    else
        export INTERACTIVE_CHROOT="${CLI_CHROOT}"
    fi

    progtest -v -w "${OUT}" -o . "${CLI_PROFILE}"

    if [[ -f "pear/profiledef.sh.backup" ]]; then
        mv pear/profiledef.sh.backup pear/profiledef.sh
        trap - EXIT INT TERM
        echo -e "[\e[92m%\e[0m] Restored original profiledef.sh"
    fi

    end=$(date +%s)
    echo -e "[ \e[32m%\e[0m ] : The command was completed in $((end - start)) seconds"

    echo -e "[ \e[92m%\e[0m ] : Fixing permissions . . ."
    chown "${SUDO_USER:-${USER:-root}}:${SUDO_USER:-${USER:-root}}" ./*.iso 2>/dev/null || true

    if [[ "${CLI_SHA256}" == "yes" ]]; then
        local iso_file
        iso_file=$(find . -maxdepth 1 -name "*.iso" -type f 2>/dev/null | grep -i pearOS | head -1)
        if [[ -n "${iso_file}" ]]; then
            echo -e "[ \e[92m%\e[0m ] : Computing sha256sum for $(basename "${iso_file}")..."
            sha256sum -- "${iso_file}" > ./sha.txt
            echo -e "[ \e[92m%\e[0m ] : Written to ./sha.txt"
            cat ./sha.txt
        else
            echo -e "[ \e[91m%\e[0m ] : No pearOS ISO file found for --sha256" >&2
        fi
    fi
}

mainmenu() {
    echo -ne "
$(magentaprint 'Choose an option:')
$(magentaprint '1)') Build ISO file
$(magentaprint '2)') Clean the Project Directory
$(magentaprint '3)') Write ISO file to USB
$(magentaprint '4)') Upload ISO to CDN (ISO Uploader)
$(magentaprint '5)') Generate sha256sum for ISO
$(redprint '0)') Exit

[ \e[93m% \e[0m] : "
    read -r ans < /dev/tty
    case $ans in
    1)
        actual_build
        ;;
    2)  clean_out
        ;;
    3)  writetousb
	;;
    4)  uploadmenu
        ;;
    5)  shaiso
        ;;
    0)
        fn_bye
        ;;
    *)
        fn_fail
        ;;
    esac
}

################################################## CUSTOM SCRIPTS ENDS ##############################################
if [ "$(id -u)" -ne 0 ]; then
        echo -e '[\e[91m%\e[0m] : This build binary must be run as root (sudo)' >&2
        exit 1
fi

# CLI flags run the matching menu action directly and skip the interactive
# menu; with no arguments the menu behaves exactly as before.
CLI_PROFILE="pear"
CLI_COMPRESSION="default"
CLI_CLEAN="no"
CLI_SHA256="no"
CLI_CHROOT="no"
CLI_YES="no"
CLI_FILENAME=""
CLI_UPLOAD_ACTION=""
CLI_DELETE_FILE=""
_cli_want_build="no"
_cli_want_clean_project="no"
_cli_want_usb="no"
_cli_args_given="no"

while [[ $# -gt 0 ]]; do
    _cli_args_given="yes"
    case "$1" in
        --build)
            _cli_want_build="yes"
            shift
            ;;
        --profile)
            CLI_PROFILE="${2:?--profile requires a value}"
            shift 2
            ;;
        --compression)
            CLI_COMPRESSION="${2:?--compression requires a value}"
            shift 2
            ;;
        --filename)
            CLI_FILENAME="${2:?--filename requires a value}"
            shift 2
            ;;
        --clean)
            CLI_CLEAN="yes"
            shift
            ;;
        --sha256)
            CLI_SHA256="yes"
            shift
            ;;
        --chroot)
            CLI_CHROOT="yes"
            shift
            ;;
        --clean-project)
            _cli_want_clean_project="yes"
            shift
            ;;
        --usb)
            _cli_want_usb="yes"
            shift
            ;;
        --upload)
            CLI_UPLOAD_ACTION="upload"
            shift
            ;;
        --list-cdn)
            CLI_UPLOAD_ACTION="list"
            shift
            ;;
        --get-links)
            CLI_UPLOAD_ACTION="links"
            shift
            ;;
        --delete-cdn)
            CLI_UPLOAD_ACTION="delete"
            CLI_DELETE_FILE="${2:?--delete-cdn requires a filename}"
            shift 2
            ;;
        -y|--yes)
            CLI_YES="yes"
            shift
            ;;
        -h|--help)
            _print_cli_usage
            exit 0
            ;;
        *)
            echo -e "[ \e[91m%\e[0m ] : Unknown option: $1" >&2
            _print_cli_usage
            exit 1
            ;;
    esac
done

# --clean-project is exclusive: it's an unrelated maintenance action, not
# something you'd chain with a build. Everything else chains in a fixed
# order -- chroot (only if standalone, i.e. no --build), then build, then
# usb, then upload -- so e.g.
#   --build --compression fastest --sha256 --upload
# builds the ISO and then uploads it in the same run (set -e above means
# the chain stops if an earlier step fails). A bare --sha256 with nothing
# else just checksums the existing ISO (menu 5), same as before.
#
# --chroot behaves differently depending on whether --build is also given:
#   --build --chroot   chroot happens mid-build (non_interactive_build sets
#                       INTERACTIVE_CHROOT=yes), the one point where
#                       airootfs exists but hasn't been consumed yet.
#   --chroot (alone)    chroots straight into whatever airootfs already
#                       exists under ./work from an earlier run -- no build
#                       is triggered just because --chroot was passed.
_cli_want_build_effective="no"
if [[ "${_cli_want_build}" == "yes" || "${CLI_CLEAN}" == "yes" \
        || "${CLI_COMPRESSION}" != "default" || "${CLI_PROFILE}" != "pear" ]]; then
    _cli_want_build_effective="yes"
fi

# If an airootfs already exists (from an earlier run), --chroot always
# means "chroot into it right now" -- cli_chroot() below always `exit 0`s
# right after, so nothing else on the command line (even --build) runs in
# this same invocation; finishing the ISO is always a separate, later
# "--build" run. Only when there's NO existing airootfs yet does --chroot
# fall back to the mid-build hook (it has to wait for --build's pacstrap
# step to create one first, and that hook also always exits right after).
_cli_existing_airootfs=$(find ./work -maxdepth 3 -type d -path "*/x86_64/airootfs" 2>/dev/null | head -n1)
_cli_want_chroot_standalone="no"
if [[ "${CLI_CHROOT}" == "yes" && -n "${_cli_existing_airootfs}" ]]; then
    _cli_want_chroot_standalone="yes"
fi
CLI_CHROOT_HANDLED_STANDALONE="${_cli_want_chroot_standalone}"

if [[ "${_cli_want_clean_project}" == "yes" ]]; then
    CLI_MODE="yes"
    clean_out
elif [[ "${_cli_want_build_effective}" == "yes" || "${_cli_want_usb}" == "yes" \
        || -n "${CLI_UPLOAD_ACTION}" || "${_cli_want_chroot_standalone}" == "yes" ]]; then
    CLI_MODE="yes"
    [[ "${_cli_want_chroot_standalone}" == "yes" ]] && cli_chroot
    [[ "${_cli_want_build_effective}" == "yes" ]] && non_interactive_build
    [[ "${_cli_want_usb}" == "yes" ]] && writetousb
    [[ -n "${CLI_UPLOAD_ACTION}" ]] && cli_upload_action
    true
elif [[ "${CLI_CHROOT}" == "yes" ]]; then
    # --chroot alone, no existing airootfs, no --build: nothing to chroot
    # into yet and no pipeline was requested to create one.
    CLI_MODE="yes"
    cli_chroot
elif [[ "${CLI_SHA256}" == "yes" ]]; then
    CLI_MODE="yes"
    shaiso
elif [[ "${_cli_args_given}" == "yes" ]]; then
    # Args were given but none selected an action (shouldn't normally
    # happen since the parser rejects unknown flags) -- fail loudly
    # instead of silently opening the interactive menu.
    echo -e "[ \e[91m%\e[0m ] : No action selected" >&2
    _print_cli_usage
    exit 1
else
    mainmenu
fi
