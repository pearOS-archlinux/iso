############### CUSTOM INTERACTIVE CHROOT FUNCTIONS (must be before mkarchiso) ###############

# Drop straight into an arch-chroot shell in $1. No menu, no y/n prompt --
# every caller of this function only calls it because --chroot was passed
# on the command line, so that's already explicit consent. There's nothing
# left to ask.
interactive_chroot() {
    local airootfs_dir="$1"

    if [[ ! -d "$airootfs_dir" ]]; then
        echo -e "[\e[91m%\e[0m] Error: airootfs directory not found!"
        return 1
    fi

    echo -e "\n[\e[94m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m]"
    echo -e "[\e[93m%\e[0m] Entering chroot: $airootfs_dir"
    echo -e "[\e[94m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m]"
    echo -e "[\e[93m%\e[0m] Tips:"
    echo -e "  - Install packages: pacman -S package-name"
    echo -e "  - Edit configs in /etc/"
    echo -e "  - Customize user settings"
    echo -e "  - Type 'exit' when done"
    echo -e ""

    arch-chroot "$airootfs_dir" /bin/bash

    echo -e "\n[\e[92m%\e[0m] Exited chroot -- airootfs keeps everything you changed."
    return 0
}

# Mid-build hook, called from _make_customize_airootfs only when
# INTERACTIVE_CHROOT=yes (i.e. --build --chroot was passed) -- see line
# ~787. Chroots directly, no prompt: passing --chroot IS the answer.
check_chroot_request() {
    local work_dir="$1"
    local airootfs_dir="${work_dir}/x86_64/airootfs"

    if [[ ! -d "$airootfs_dir" ]]; then
        echo -e "[\e[91m%\e[0m] Error: airootfs directory not found at $airootfs_dir"
        return 1
    fi

    echo -e "\n[\e[94m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m]"
    echo -e "[\e[93m%\e[0m] System installation complete -- chrooting in (--chroot was given)"
    echo -e "[\e[94m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m]"

    interactive_chroot "$airootfs_dir"

    # Stop here, deliberately -- don't fall through to squashfs/ISO
    # creation in this same run. pacstrap is already done and airootfs
    # keeps every change from the chroot session; compression/sha256/
    # filename are decided in a SEPARATE, later "--build" run that reuses
    # this same ./work (pacstrap is skipped -- see the marker-clearing in
    # non_interactive_build) and only finishes the squashfs + ISO.
    echo -e "\n[\e[92m%\e[0m] : Stopping here -- airootfs is ready, nothing built into an ISO yet."
    echo -e "[\e[92m%\e[0m] : Run \"--build\" again (same ./work, pacstrap skipped) whenever you're ready to finish it."
    exit 0
}

